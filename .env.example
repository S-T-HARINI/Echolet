# ==============================================================================
# EchoLet Environment Configuration Template
# Copy this file to .env for custom local or production overrides.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_NAME="EchoLet API"
APP_VERSION=1.0.0

# ------------------------------------------------------------------------------
# PostgreSQL Database (Docker or Production)
# ------------------------------------------------------------------------------
# Async database URL (uses psycopg or asyncpg)
DATABASE_URL=postgresql+psycopg://echolet:echolet_password@localhost:5432/echolet

# Synchronous database URL for Alembic migrations
SYNC_DATABASE_URL=postgresql://echolet:echolet_password@localhost:5432/echolet

# Fallback for local zero-dependency development without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./echolet.db
# SYNC_DATABASE_URL=sqlite:///./echolet.db

# ------------------------------------------------------------------------------
# Mock HTTP Notification Service
# ------------------------------------------------------------------------------
MOCK_NOTIFICATION_URL=http://localhost:8001/api/v1/notify
MOCK_NOTIFICATION_SERVICE_BASE=http://localhost:8001

# ------------------------------------------------------------------------------
# Outbox Worker Configuration
# ------------------------------------------------------------------------------
WORKER_ID=echolet-worker-1
WORKER_POLL_INTERVAL=1.0
WORKER_BATCH_SIZE=20
WORKER_LEASE_SECONDS=30
WORKER_BASE_RETRY_DELAY=2.0
WORKER_MAX_RETRY_DELAY=300.0
WORKER_HTTP_TIMEOUT=3.0

# ------------------------------------------------------------------------------
# Frontend Dashboard
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MOCK_SERVICE_URL=http://localhost:8001
